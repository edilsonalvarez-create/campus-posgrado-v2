# ─── Campus Posgrado v2 · backend (simple-server.js + PostgreSQL) ───
# Copia a `.env` para desarrollo local. En Railway se configuran como variables
# del servicio. Solo `ANTHROPIC_API_KEY` es secreto; el resto es configuración.

# ── Base de datos (obligatorio) ──────────────────────────────────────
# Opción A: cadena única (la que usa Railway)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_posgrado
# Opción B: variables sueltas (si no hay DATABASE_URL)
#DB_HOST=localhost
#DB_PORT=5432
#DB_USERNAME=postgres
#DB_PASSWORD=postgres
#DB_DATABASE=campus_posgrado
# Tamaño máximo del pool de conexiones (por defecto 10)
#PG_POOL_MAX=10

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3001

# ── Arranque: migraciones + seed ─────────────────────────────────────
# Las migraciones (db/migrations/*.sql) SIEMPRE corren al arrancar (idempotentes).
# AUTO_SEED controla si además se ejecuta el seed no destructivo al arrancar:
#   sync  → ejecuta db/seed.js en cada arranque (recomendado en Railway)
#   auto  → ejecuta el seed solo si el catálogo está vacío
#   false → no siembra al arrancar (usar `npm run seed` a mano)
AUTO_SEED=false
# Sembrar además usuarios/matrículas/progreso de demo (solo dev; en prod: false)
SEED_DEMO_DATA=false

# ── Motor de exámenes ────────────────────────────────────────────────
# Horas de espera entre intentos de examen (por defecto 24)
#EXAM_COOLDOWN_HOURS=24

# ── Integración LLM (tutor socrático + asistencia de nota) ────────────
# LLM_PROVIDER: none (por defecto, sin IA) | anthropic
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
LLM_MODEL_HEAVY=claude-opus-5
# SECRETO — solo si LLM_PROVIDER=anthropic. No lo pongas en este fichero de ejemplo.
#ANTHROPIC_API_KEY=

# ── Correo transaccional (recuperación de contraseña, todos los roles) ─
# EMAIL_PROVIDER: none (por defecto, no envía; deja el enlace en el log) | resend
EMAIL_PROVIDER=none
# SECRETO — solo si EMAIL_PROVIDER=resend. No lo pongas en este fichero de ejemplo.
#RESEND_API_KEY=
# Remitente. Sin dominio propio verificado en Resend, usar el sandbox de abajo.
RESEND_FROM_EMAIL=Campus Posgrado <onboarding@resend.dev>
# Base para el enlace de restablecimiento (el frontend en Vercel)
FRONTEND_URL=https://campus-posgrado-v2.vercel.app

# ── Referencia de catálogo por asignatura (opcional) ─────────────────
# El IEP no publica clave de catálogo por asignatura; el seed usa
# `IEP-<numeral>-INTERNO`. Si el IEP facilita la clave real, se inyecta aquí
# (numerales: I II III IV V VI VII VIII IX X XI TFM).
#OFFICIAL_CODE_V=
#OFFICIAL_CODE_VIII=
#OFFICIAL_CODE_TFM=
