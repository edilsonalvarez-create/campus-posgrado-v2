            "title": "Historia y Evolución de la IA",
            "resources": [
              {
                "type": "lecture",
                "title": "Orígenes de la IA: Del test de Turing a GPT",
                "duration": "45 min",
                "content": "Exploración de los hitos principales en la historia de la IA desde 1950 hasta 2024",
                "materials": [
                  "lecture-ia-history.pdf",
                  "timeline-ia.png"
                ]
              },
              {
                "type": "video",
                "title": "What is Artificial Intelligence? (MIT)",
                "duration": "20 min",
                "url": "https://www.youtube.com/watch?v=AI-example",
